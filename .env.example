# Segurança e persistência (servidor). Gere cada segredo com: openssl rand -hex 32
APP_ACCESS_TOKEN=
APP_ENCRYPTION_KEY=
APP_CONTACT_EMAIL=
DATABASE_PATH=./data/dropradar.sqlite

# Pesquisa e geração de conteúdo
TAVILY_API_KEY=
GEMINI_API_KEY=

# Fornecedor internacional CJdropshipping (API Key é o método recomendado)
CJ_API_KEY=
# Opcional: somente para diagnóstico/legado; expira e exige renovação manual.
CJ_ACCESS_TOKEN=
CJ_ENVIRONMENT=test

# Câmbio de contingência; deixe vazio para usar a cotação datada da API.
USD_BRL_RATE=

# Nuvemshop: OAuth do app (preferido)
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
# Alternativa opcional para uma única loja
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=

# Checkout e webhook
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=test
MAX_OFFER_AGE_HOURS=72

# URL pública HTTPS, sem barra final. Necessária para OAuth e webhooks.
STORE_BASE_URL=

# TikTok Login Kit / Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
